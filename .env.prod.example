# Root Docker/deploy scenario file for production image publishing. Copy to .env.prod.

# Registry and image defaults.
REGISTRY_REF=registry.example.com:5000
IMAGE_TAG=latest
API_HOST_PORT=8040
DASHBOARD_HOST_PORT=3050

# GPU host reached over SSH. The user must be able to run llama-server and nvidia-smi.
REMOTE_MODE=ssh
GPU_SSH_HOST=192.168.1.50
GPU_SSH_PORT=22
GPU_SSH_USER=me
# Authenticate with a private key, a password, or both (the key is tried first).
# Private key on the Docker host; it is mounted read-only into the api-server container.
# Leave empty to use only the password.
GPU_SSH_KEY_FILE=/home/me/.ssh/id_ed25519
GPU_SSH_PASSWORD=
# Path inside the container to a known_hosts file. Leave empty to skip host key checks.
GPU_SSH_KNOWN_HOSTS=
# Where server logs are kept on the GPU host.
REMOTE_STATE_DIR=~/.local/state/local-llm-cp

# Extra dashboard origins allowed to call the API. Private-network origins are always allowed.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3050

# Leave empty so the dashboard calls http://<host it was opened on>:API_HOST_PORT.
# Set it only when the API is published under a different address.
VITE_API_BASE_URL=
