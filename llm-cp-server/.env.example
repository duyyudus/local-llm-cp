# Copy to .env for running the backend outside Docker.
DATABASE_URL=sqlite+aiosqlite:///./data/llm-cp.db

# ssh: control a GPU host over SSH. local: run everything on this machine (development).
REMOTE_MODE=ssh
GPU_SSH_HOST=192.168.1.50
GPU_SSH_PORT=22
GPU_SSH_USER=me
# Authenticate with a private key, a password, or both (the key is tried first).
GPU_SSH_KEY_PATH=~/.ssh/id_ed25519
GPU_SSH_PASSWORD=
# Leave empty to skip host key verification (LAN use).
GPU_SSH_KNOWN_HOSTS=
REMOTE_STATE_DIR=~/.local/state/local-llm-cp

API_CORS_ORIGINS=http://localhost:5173
